# NextAuth.
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=your_32_char_secret_here_replace_me

# Backend bearer-token signing. Must match backend JWT_SECRET.
BACKEND_JWT_SECRET=use_the_same_32_char_value_as_backend_JWT_SECRET
BACKEND_JWT_ISSUER=nyaysetu-frontend
BACKEND_JWT_AUDIENCE=nyaysetu-backend

# Google OAuth. Leave blank if only using demo accounts locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon PostgreSQL.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/nyaysetu?sslmode=require

# Python backend. For Hugging Face Spaces use:
# https://ayush712145-nyay-setu-backend.hf.space
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
PYTHON_BACKEND_URL=http://localhost:8000