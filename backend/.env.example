# AI provider keys. At least one is required for live model synthesis.
ANTHROPIC_API_KEY=your_claude_key
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key

# Sarvam AI voice/STT.
SARVAM_API_KEY=your_sarvam_key

# Google Meet the Builders mode.
# false = Gemini REST + Sarvam STT + Neon
# true  = Vertex AI Gemini + Google Cloud STT + Firestore sessions
USE_GOOGLE_CLOUD=false
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=asia-south1
FIRESTORE_CASES_COLLECTION=cases

# IndianKanoon legal research API.
INDIANKANOON_API_KEY=your_indiankanoon_key

# Optional Twilio WhatsApp/SMS notifications.
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Neon PostgreSQL. Use the asyncpg-compatible URL, without +asyncpg.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/nyaysetu?sslmode=require

# Optional Upstash Redis.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Short-lived backend bearer-token signing secret.
# Frontend BACKEND_JWT_SECRET must use the same value.
JWT_SECRET=your_32_char_secret_here
JWT_ALGORITHM=HS256
JWT_ISSUER=nyaysetu-frontend
JWT_AUDIENCE=nyaysetu-backend

# CORS. Use comma-separated origins with no trailing slash.
ALLOWED_ORIGINS=https://nyay-setu-arch.vercel.app,http://localhost:3005,http://localhost:3000

ENVIRONMENT=production
LOG_LEVEL=info

# Durable document-analysis worker.
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_JOB_LEASE_SECONDS=90
ANALYSIS_JOB_HEARTBEAT_SECONDS=20
ANALYSIS_JOB_POLL_SECONDS=1.0
ANALYSIS_JOB_RETRY_BASE_SECONDS=15
ANALYSIS_JOB_RETRY_MAX_SECONDS=300
ANALYSIS_JOB_STALE_RECOVERY_SECONDS=30
ANALYSIS_SSE_POLL_SECONDS=1.0
ANALYSIS_SSE_HEARTBEAT_SECONDS=15

# Document storage. Use local for demos, s3 for production durability.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_ROOT=data/document-intelligence
DOCUMENT_DEFAULT_TENANT_ID=default
MAX_DOCUMENT_UPLOAD_MB=50
DOCUMENT_API_RATE_LIMIT_PER_MINUTE=120
DOCUMENT_UPLOAD_RATE_LIMIT_PER_MINUTE=10
DOCUMENT_ANALYSIS_RATE_LIMIT_PER_HOUR=10
DOCUMENT_SEARCH_RATE_LIMIT_PER_MINUTE=30
DOCUMENT_MONTHLY_UPLOAD_MB=500
DOCUMENT_MONTHLY_UPLOAD_FILES=200
DOCUMENT_MALWARE_SCANNER=disabled
DOCUMENT_MALWARE_SCAN_REQUIRED=false
DOCUMENT_AUDIT_REQUIRED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# PDF and OCR limits.
PDF_TEXT_QUALITY_THRESHOLD=0.55
PDF_MIN_DIGITAL_TEXT_CHARS=24
PDF_OCR_DPI=200
DOCUMENT_OCR_LANGUAGES=eng+hin
PDF_MAX_PAGES=500
PDF_MAX_PAGE_PIXELS=40000000
PDF_MAX_TOTAL_OCR_PIXELS=500000000
PDF_MAX_EMBEDDED_IMAGE_PIXELS=500000000
PDF_MAX_IMAGES_PER_PAGE=200
PDF_MAX_PAGE_TEXT_CHARS=2000000

# S3-compatible document storage.
S3_DOCUMENT_BUCKET=
S3_DOCUMENT_PREFIX=nyaysetu
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=auto
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
S3_SIGNED_URL_SECONDS=900