# AI Keys
ANTHROPIC_API_KEY=your_claude_key
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key

# Sarvam AI (voice STT — 22 Indian languages)
SARVAM_API_KEY=your_sarvam_key

# Google Meet the Builders mode
# false = IIT path: Gemini REST + Sarvam STT + Neon
# true  = Google path: Vertex AI Gemini + Cloud STT + Firestore sessions
USE_GOOGLE_CLOUD=false
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=asia-south1
FIRESTORE_CASES_COLLECTION=cases

# IndianKanoon API
INDIANKANOON_API_KEY=your_indiankanoon_key

# Neon PostgreSQL (asyncpg driver — note: no +asyncpg prefix needed for asyncpg direct)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/nyaysetu?sslmode=require

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# JWT secret (shared with Next.js NextAuth secret — must be 32+ chars)
JWT_SECRET=your_32_char_secret_here

# CORS — comma-separated, no trailing slash
ALLOWED_ORIGINS=https://nyaysetu.vercel.app,http://localhost:3000

# Environment
ENVIRONMENT=production
LOG_LEVEL=info
